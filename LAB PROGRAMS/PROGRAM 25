/* 25. Implementation of Minimum Spanning Tree using Kruskal Algorithm */
#include <stdio.h>
#include <stdlib.h>

#define MAX 100

struct Edge {
    int src, dest, weight;
};

int parent[MAX];

int findSet(int i) {
    while (parent[i] != i)
        i = parent[i];
    return i;
}

void unionSet(int a, int b) {
    int rootA = findSet(a);
    int rootB = findSet(b);
    if (rootA != rootB)
        parent[rootA] = rootB;
}

int compareEdges(const void *a, const void *b) {
    struct Edge *e1 = (struct Edge *)a;
    struct Edge *e2 = (struct Edge *)b;
    return e1->weight - e2->weight;
}

int main() {
    int n, edgeCount;

    printf("Enter number of vertices: ");
    scanf("%d", &n);

    printf("Enter number of edges: ");
    scanf("%d", &edgeCount);

    struct Edge edges[edgeCount];

    printf("Enter edges as (u v weight), vertices numbered 0 to %d:\n", n - 1);
    for (int i = 0; i < edgeCount; i++)
        scanf("%d %d %d", &edges[i].src, &edges[i].dest, &edges[i].weight);

    qsort(edges, edgeCount, sizeof(edges[0]), compareEdges);

    for (int i = 0; i < n; i++)
        parent[i] = i;

    int totalWeight = 0;
    int mstEdgeCount = 0;

    printf("\nEdges in Minimum Spanning Tree:\n");
    for (int i = 0; i < edgeCount && mstEdgeCount < n - 1; i++) {
        int u = edges[i].src;
        int v = edges[i].dest;

        int rootU = findSet(u);
        int rootV = findSet(v);

        if (rootU != rootV) {
            printf("%d - %d\tWeight: %d\n", u, v, edges[i].weight);
            totalWeight += edges[i].weight;
            unionSet(rootU, rootV);
            mstEdgeCount++;
        }
    }

    printf("Total weight of Minimum Spanning Tree: %d\n", totalWeight);

    return 0;
}
